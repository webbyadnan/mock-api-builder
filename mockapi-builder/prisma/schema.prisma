generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── NextAuth.js Models ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  members       ProjectMember[]
  sentInvites   ProjectInvite[] @relation("SentInvites")
  chatMessages  ChatMessage[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ──────────────────────────────────────

model Project {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoints Endpoint[]
  members   ProjectMember[]
  logs      RequestLog[]
  invites   ProjectInvite[]
  messages  ChatMessage[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([slug])
}

model Endpoint {
  id         String   @id @default(cuid())
  method     String
  path       String
  statusCode Int      @default(200)
  headers    Json     @default("{}")
  body       Json
  delay      Int      @default(0)
  isActive   Boolean  @default(true)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  logs       RequestLog[]
  chatMessages ChatMessage[]

  @@index([projectId])
  @@unique([projectId, method, path])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectInvite {
  id            String   @id @default(cuid())
  projectId     String
  inviterUserId String
  inviteeEmail  String
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter  User    @relation("SentInvites", fields: [inviterUserId], references: [id], onDelete: Cascade)

  @@index([inviteeEmail])
  @@index([projectId])
}

model ChatMessage {
  id         String    @id @default(cuid())
  projectId  String
  userId     String
  message    String
  endpointId String?
  createdAt  DateTime  @default(now())

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // INVITE, INVITE_ACCEPTED, MEMBER_JOINED
  title     String
  message   String
  link      String?
  meta      Json?    // extra data like inviteId, projectId
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RequestLog {
  id          String   @id @default(cuid())
  projectId   String
  endpointId  String?
  method      String
  path        String
  status      Int
  headers     Json
  body        Json?
  query       Json?
  ip          String?
  createdAt   DateTime @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint    Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([endpointId])
}
